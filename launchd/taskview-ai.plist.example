<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>__LABEL_PREFIX__.taskview-ai</string>
<key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>__ORQ_DIR__/ai-dispatch.py</string></array>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
<key>StartInterval</key><integer>60</integer>
<key>StandardErrorPath</key><string>/tmp/taskview-ai.err</string>
</dict></plist>
