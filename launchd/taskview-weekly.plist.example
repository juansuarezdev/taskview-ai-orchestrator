<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>__LABEL_PREFIX__.taskview-weekly</string>
<key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>__ORQ_DIR__/weekly.py</string></array>
<key>StartCalendarInterval</key><dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
<key>StandardErrorPath</key><string>/tmp/taskview-weekly.err</string>
</dict></plist>
