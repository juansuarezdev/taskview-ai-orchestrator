<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>__LABEL_PREFIX__.claude-interactive-handoff</string>
<key>ProgramArguments</key><array>
  <string>/usr/bin/python3</string>
  <string>__ORQ_DIR__/claude-interactive-handoff.py</string>
</array>
<key>StartInterval</key><integer>60</integer>
<key>RunAtLoad</key><true/>
<key>StandardErrorPath</key><string>/tmp/claude-interactive-handoff.err</string>
<key>StandardOutPath</key><string>/tmp/claude-interactive-handoff.out</string>
<key>EnvironmentVariables</key><dict>
  <key>PATH</key><string>__HOME__/.local/bin:__HOME__/.opencode/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
</dict>
</dict></plist>
